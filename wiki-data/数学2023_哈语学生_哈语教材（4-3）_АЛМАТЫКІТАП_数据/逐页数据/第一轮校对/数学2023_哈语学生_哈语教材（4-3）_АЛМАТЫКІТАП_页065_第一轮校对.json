  "corrections": {
    "2": "ШЫҒАРМАШЫЛЫҚ ЖҰМЫС",
    "4": "Төрт гүлі бар шаршы пішінді торт",
    "5": "берілген. Әрқайсысында бір гүлден",
    "7": "",
    "9": "СЕН ЗЕРТТЕУШІСІҢ",
    "14": "да Арман – төрт сағат, Айна – үш сағат, ал Ерлан екі сағат",
    "17": "ҮЙ ТАПСЫРМАСЫ",
    "18": "Көзмөлшеріңді тексер. Суреттердің әрқайсысында қай",
    "19": "кесінді ұзынырақ екендігін анықтай аласың ба? Кесін-",
    "20": "ділердің ұзындығын өлшеп, дәптеріңдегі кестеге жаз.",
