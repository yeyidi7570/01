  "corrections": {
    "1": "МӘДЕНИ МҰРА",
    "2": "ҚАЗАҚТЫҢ",
    "3": "Мен күй тыңдадым.",
    "4": "дара мүше",
    "5": "• Сөйлемнің дара және",
    "6": "Әли кітап оқып отыр.",
    "7": "күрделі мүше",
    "8": "күрделі мүшелерін ажырату-",
    "9": "Ақылды әрі иманды",
    "10": "ды, оларды сөйлем мүшелеріне",
    "12": "бала үлкендерді",
    "13": "• сөйлемнен бірыңғай мүше-",
    "14": "құрметтейді.",
    "17": "• түрлі жанрда бір тақырыппен берілген мәтіндерді",
    "19": "• хабарлама мен мақаланы салыстыруды, олардың",
    "20": "ұқсастықтары мен айырмашылықтарын табуды;",
    "21": "• мақала жазуды үйренемін."
  },
