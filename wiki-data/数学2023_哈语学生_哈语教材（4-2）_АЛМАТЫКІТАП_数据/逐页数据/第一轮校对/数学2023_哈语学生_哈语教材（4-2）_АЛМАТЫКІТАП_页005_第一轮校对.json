{
  "page": 5,
  "corrections": {
    "0": "",
    "1": "ЖҰМЫС ІСТЕУ КЕРЕК?",
    "3": "Сабақтың лексикалық тақырыбы",
    "5": "ШЫҒАРМАШЫЛЫҚ ЖҰМЫС",
    "10": "таңдауды қажет ететін тапсырмалар.",
    "12": "ТОПТЫҚ ЖҰМЫС",
    "14": "Топтағы балалармен бірге орындайтын",
    "15": "тапсырмалар. Шешу жолын талқылап, бірге",
    "17": "іздендер. Өз шешіміңді сыныпқа ұсын. Өз",
    "18": "көзқарасыңды айтуды және басқаларды",
    "19": "",
    "22": "МАТЕМАТИКА КҮНДЕЛІКТІ ӨМІРДЕ",
    "23": "",
    "24": "сабақтар, тапсырмалар",
    "25": "Біліміңді күнделікті өмірде пайдалана білуге",
    "26": "үйрететін тапсырмалар.",
    "30": "ӨЗІНДІК ЖҰМЫС",
    "31": "Бұл – өз бетіңше орындауға арналған тапсыр-",
    "33": "малар. Тақырыпты қалай меңгергеніңді түсіну",
    "34": "үшін тапсырманы орында және оны мұғалімнің",
    "36": "үлгісі бойынша тексер. Егер қателессең, қатемен",
    "37": "жұмыс жүргіз.",
    "38": "ҮЙ ТАПСЫРМАСЫ",
    "39": "Жаңа білімді қолдануға арналған",
    "40": "СЫНЫПТАСТАРЫҢА",
    "41": "ҚҰРАСТЫР",
    "42": "СҰРАҚТАР",
    "43": "үй жұмысының тапсырмалары",
    "44": "Сабақ соңында нені",
    "49": "",
    "53": "",
    "61": "",
    "62": ""
  },
