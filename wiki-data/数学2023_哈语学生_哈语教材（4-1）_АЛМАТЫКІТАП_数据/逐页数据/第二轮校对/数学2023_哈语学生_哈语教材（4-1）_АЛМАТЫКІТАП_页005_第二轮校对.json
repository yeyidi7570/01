  "corrections": {
    "1": "ЖҰМЫС ІСТЕУ КЕРЕК?",
    "3": "Сабақтың лексикалық тақырыбы",
    "5": "ШЫҒАРМАШЫЛЫҚ ЖҰМЫС",
    "10": "таңдауды қажет ететін тапсырмалар.",
    "12": "ТОПТЫҚ ЖҰМЫС",
    "14": "Топтағы балалармен бірге орындайтын",
    "15": "тапсырмалар. Шешу жолын талқылап, бірге",
    "17": "іздендер. Өз шешіміңді сыныпқа ұсын. Өз",
    "18": "көзқарасыңды айтуды және басқаларды",
    "21": "МАТЕМАТИКА КҮНДЕЛІКТІ ӨМІРДЕ",
    "23": "Біліміңді күнделікті өмірде пайдалана білуге",
    "25": "7",
    "24": "үйрететін тапсырмалар.",
    "28": "ӨЗІНДІК ЖҰМЫС",
    "29": "Бұл – өз бетіңше орындауға арналған тапсыр-",
    "31": "малар. Тақырыпты қалай меңгергеніңді түсіну",
    "32": "үшін тапсырманы орында және оны мұғалімнің",
    "34": "үлгісі бойынша тексер. Егер қателессең, қатемен",
    "35": "жұмыс жүргіз.",
    "36": "ҮЙ ТАПСЫРМАСЫ",
    "38": "СЫНЫПТАСТАРЫҢА",
    "37": "Жаңа білімді қолдануға арналған",
    "39": "СҰРАҚТАР",
    "40": "үй жұмысының тапсырмалары",
    "41": "ҚҰРАСТЫР",
    "42": "Сабақ соңында нені",
    "43": "үйренгеніңді анықта.",
